  "license": "Apache-2.0",
  "keywords": [
    "OpenHarmony",
    "HarmonyOS",
    "ArkUI",
    "drawer",
    "like-ios",
    "ios-like",
    "frosted-glass",
    "bottom-sheet",
    "draggable"
  ],
  "dependencies": {}
}
